#!/usr/bin/env bash
# Blocks commits that contain API keys/secrets. Enabled via: git config core.hooksPath .githooks
set -u
files=$(git diff --cached --name-only --diff-filter=ACM)
bad=0
for f in $files; do
  case "$f" in .env|.env.*) [[ "$f" == ".env.example" ]] || { echo "BLOCKED: $f is an env file"; bad=1; } ;; esac
  [[ -f "$f" ]] || continue
  if git show ":$f" 2>/dev/null | grep -aEq 'fal_sk_[A-Za-z0-9]{12,}|sk-ant-[A-Za-z0-9_-]{10,}|sk-[A-Za-z0-9]{32,}|AKIA[0-9A-Z]{16}|(API_KEY|FAL_KEY|SECRET|TOKEN)[A-Z_]*[[:space:]]*=[[:space:]]*["'"'"']?[A-Za-z0-9:_-]{24,}'; then
    echo "BLOCKED: possible API key/secret in $f"; bad=1
  fi
done
[[ $bad -eq 0 ]] || { echo "Commit aborted. Remove the secret (keep keys only in .env)."; exit 1; }
